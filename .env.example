# ==================================================
# Job Alert System — Environment Variables
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==================================================

# ── Telegram ──────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Numeric ID of the private group or channel.
# For a group: -100xxxxxxxxxx  (note the leading -100)
# For a channel: @channel_username  or  -100xxxxxxxxxx
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Database ──────────────────────────────────────
# Relative or absolute path to the SQLite database file.
# Default: database/jobs.db
DB_PATH=database/jobs.db

# ── Scraper ───────────────────────────────────────
# Path to the companies configuration JSON.
# Default: config/companies.json
COMPANIES_PATH=config/companies.json

# Seconds to wait between scraping different companies.
# Increase to reduce risk of IP rate-limiting.
INTER_REQUEST_DELAY=1.0

# ── Notifications ────────────────────────────────
# Set to "false" to suppress the end-of-run summary message.
SEND_SUMMARY=true
